# Example Environment Configuration (Template)
# Copy this file to .env and fill in your actual values.

# Render Deployment Credentials
RENDER_API_KEY=your_render_api_key_here
RENDER_SERVICE_ID=your_render_service_id_here
RENDER_SERVICE_URL=https://your-service-name.onrender.com

# GitHub Repository
GITHUB_REPO_URL=https://github.com/username/repository.git
